# =============================================================
# SatQuest landing env — sample file (safe to commit).
# Copy to `.env` and fill in real values; `.env` is gitignored.
# Only vars prefixed with VITE_ are exposed to the browser.
# =============================================================

# Base URL of the NestJS backend API (used by Leaderboard & Feedback).
# - Leave as default for local dev.
# - In production set this to the deployed API origin, e.g.
#   VITE_API_BASE=https://api.satquest.app/api
VITE_API_BASE=http://localhost:3000/api

# URL of the deployed SatQuest app (used for "Play the App" / "Open the App" links).
# - In production set this to the deployed frontend origin, e.g.
#   VITE_APP_URL=https://app.satquest.app
VITE_APP_URL=https://satquests.netlify.app
